# ============================================================================
#  LARIZINHA STORE — VARIÁVEIS DE AMBIENTE
# ============================================================================
#  Copie este arquivo para ".env" e preencha com seus dados reais.
#
#  Comando:
#    cp .env.example .env
#
#  Depois edite o .env com seus valores.
# ============================================================================


# ════════════════════════════════════════════════════════════════════════════
#  🚀 AMBIENTE GERAL
# ════════════════════════════════════════════════════════════════════════════
NODE_ENV=production
APP_NAME=Larizinha Store
APP_VERSION=4.1.0
APP_URL=https://larizinhastore.com
APP_PORT=3000
TZ=America/Sao_Paulo

# Nível de log: error | warn | info | debug
LOG_LEVEL=info
LOG_DIR=./logs

# Separador universal usado nos comandos administrativos
# Ex: NOME===VALOR
DEFAULT_SEPARATOR===


# ════════════════════════════════════════════════════════════════════════════
#  👑 OWNER (DONO DO BOT)
# ════════════════════════════════════════════════════════════════════════════
# ID do Telegram do dono (você). Este ID é cadastrado como "owner" no boot.
# Descubra o seu enviando /id para o bot @userinfobot no Telegram.
OWNER_TELEGRAM_ID=000000000


# ════════════════════════════════════════════════════════════════════════════
#  🤖 TELEGRAM — BOT ADMINISTRATIVO
# ════════════════════════════════════════════════════════════════════════════
ADMIN_BOT_TOKEN=8464485123:AAGfibOpvx6ASRrcepmQJlZ1GuoAAYml6Ws
ADMIN_BOT_USERNAME=LarizinhaAdminBot

# Webhook do bot admin (opcional — se não usar, fica em polling)
ADMIN_USE_WEBHOOK=false
ADMIN_WEBHOOK_DOMAIN=https://admin.larizinhastore.com
ADMIN_WEBHOOK_PORT=3001
ADMIN_WEBHOOK_SECRET=troque_este_secret_admin


# ════════════════════════════════════════════════════════════════════════════
#  🛍 TELEGRAM — BOT CLIENTE (LOJA)
# ════════════════════════════════════════════════════════════════════════════
CLIENT_BOT_TOKEN=8372698551:AAFISLiiIj93jaBaNNr1WayKW9AHTUEgJw0
CLIENT_BOT_USERNAME=LarizinhaStoreBot

# Webhook do bot cliente (opcional)
CLIENT_USE_WEBHOOK=false
CLIENT_WEBHOOK_DOMAIN=https://bot.larizinhastore.com
CLIENT_WEBHOOK_PORT=3002
CLIENT_WEBHOOK_SECRET=troque_este_secret_client


# ════════════════════════════════════════════════════════════════════════════
#  📢 CANAL OBRIGATÓRIO
# ════════════════════════════════════════════════════════════════════════════
# ID numérico do canal (ex: -1002531391775)
# Você precisa adicionar o bot como ADMIN do canal.
REQUIRED_CHANNEL_ID=-1002531391775
REQUIRED_CHANNEL_LINK=https://t.me/+seu_link_do_canal
REQUIRED_CHANNEL_NAME=COMPRAS + ESTOQUES

# Tempo em segundos para cache da verificação (padrão 60s)
CHANNEL_CHECK_CACHE_TTL=60

# Chat onde o bot envia notificações internas de venda
LOG_CHAT_ID=-1002531391775


# ════════════════════════════════════════════════════════════════════════════
#  🗄️ BANCO DE DADOS — PostgreSQL
# ════════════════════════════════════════════════════════════════════════════
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=larizinha_store
DB_USER=larizinha_user
DB_PASSWORD=troque_esta_senha_forte
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_LOGGING=false
DB_TIMEZONE=-03:00


# ════════════════════════════════════════════════════════════════════════════
#  ⚡ REDIS — Cache / Sessões / Filas
# ════════════════════════════════════════════════════════════════════════════
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_ADMIN=1
REDIS_DB_CLIENT=2
REDIS_DB_QUEUE=3
REDIS_DB_CACHE=4
REDIS_PREFIX=larizinha:


# ════════════════════════════════════════════════════════════════════════════
#  💳 MERCADO PAGO — Pagamento PIX (REAL)
# ════════════════════════════════════════════════════════════════════════════
# Access Token do Mercado Pago (produção)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-2521650109262652-052114-1c9fbbe2ebcc9064b804fb615f874a19-689993014

# Public Key (usado pelo Mini App / front-end)
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Webhook secret (definido no painel do Mercado Pago)
MERCADOPAGO_WEBHOOK_SECRET=troque_este_secret_mp

# URL pública do seu webhook (deve ser HTTPS)
MERCADOPAGO_WEBHOOK_URL=https://api.larizinhastore.com/webhooks/mercadopago

# Ambiente: sandbox | production
MERCADOPAGO_ENVIRONMENT=production


# ════════════════════════════════════════════════════════════════════════════
#  📱 WHATSAPP — Cloud API Oficial (Meta)
# ════════════════════════════════════════════════════════════════════════════
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=troque_este_token_verify
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_PORT=3003

# Número público para exibição (apenas visual)
WHATSAPP_PUBLIC_NUMBER=5544998312326


# ════════════════════════════════════════════════════════════════════════════
#  📧 E-MAIL — SMTP
# ════════════════════════════════════════════════════════════════════════════
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=seuemail@gmail.com
MAIL_PASSWORD=sua_senha_de_app
MAIL_FROM_NAME=Larizinha Store
MAIL_FROM_ADDRESS=nao-responda@larizinhastore.com
MAIL_REPLY_TO=suporte@larizinhastore.com

# Alternativa: SendGrid
SENDGRID_API_KEY=


# ════════════════════════════════════════════════════════════════════════════
#  🤖 OPENAI — IA de Atendimento
# ════════════════════════════════════════════════════════════════════════════
OPENAI_ENABLED=true
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=800
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT_MS=30000


# ════════════════════════════════════════════════════════════════════════════
#  🌐 WEBSITE / MINI APP
# ════════════════════════════════════════════════════════════════════════════
WEB_URL=https://larizinhastore.com
WEB_PORT=3000
WEB_JWT_SECRET=troque_este_jwt_secret_website
WEB_SESSION_SECRET=troque_este_session_secret_website
WEB_COOKIE_DOMAIN=.larizinhastore.com

# Mini App (WebApp do Telegram) — URL que o bot abre
MINIAPP_URL=https://larizinhastore.com/miniapp


# ════════════════════════════════════════════════════════════════════════════
#  🛡️ ANTI-FLOOD (configurável no admin, mas precisa de defaults)
# ════════════════════════════════════════════════════════════════════════════
ANTIFLOOD_DEFAULT_ENABLED=true
ANTIFLOOD_DEFAULT_MAX_MESSAGES=10
ANTIFLOOD_DEFAULT_WINDOW_SECONDS=5
ANTIFLOOD_DEFAULT_BLOCK_MINUTES=10
ANTIFLOOD_ADMIN_BYPASS=true
ANTIFLOOD_REDIS_DB=4


# ════════════════════════════════════════════════════════════════════════════
#  🔧 MANUTENÇÃO
# ════════════════════════════════════════════════════════════════════════════
MAINTENANCE_DEFAULT_MESSAGE=🔧 BOT EM MANUTENÇÃO\nEstamos realizando uma manutenção. Tente novamente mais tarde.
MAINTENANCE_RETURN_MESSAGE=🟢 BOT ONLINE\nA manutenção foi finalizada. O bot já está funcionando normalmente!
MAINTENANCE_ALLOW_ADMINS=true


# ════════════════════════════════════════════════════════════════════════════
#  ⏰ AGENDADOR / FILAS
# ════════════════════════════════════════════════════════════════════════════
QUEUE_PREFIX=larizinha
QUEUE_CRON_TIMEZONE=America/Sao_Paulo
QUEUE_MAX_CONCURRENCY=5
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=5000


# ════════════════════════════════════════════════════════════════════════════
#  📂 ARMAZENAMENTO (uploads de imagens do admin)
# ════════════════════════════════════════════════════════════════════════════
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_URL=https://api.larizinhastore.com/uploads
STORAGE_MAX_FILE_SIZE_MB=10

# Se usar S3 (opcional, para produção)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=larizinha-uploads


# ════════════════════════════════════════════════════════════════════════════
#  🎫 GIFT CARDS / AFILIADOS / SAQUES
# ════════════════════════════════════════════════════════════════════════════
AFFILIATE_COMMISSION_PERCENT=20
AFFILIATE_POINTS_PER_RECHARGE=1
AFFILIATE_MIN_POINTS_TO_CONVERT=500
AFFILIATE_MULTIPLIER=0.01
AFFILIATE_MIN_WITHDRAW=20
AFFILIATE_WITHDRAW_AUTO_APPROVE=false

GIFTCARD_CODE_LENGTH=12
GIFTCARD_ONE_PER_USER=true


# ════════════════════════════════════════════════════════════════════════════
#  🔐 SEGURANÇA ADMIN
# ════════════════════════════════════════════════════════════════════════════
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOGIN_BLOCK_MINUTES=30
ADMIN_REQUIRE_2FA=false
ADMIN_CRITICAL_ACTION_CONFIRM=true


# ════════════════════════════════════════════════════════════════════════════
#  📋 TERMOS DE USO
# ════════════════════════════════════════════════════════════════════════════
TERMS_URL=https://telegra.ph/Termos-de-uso-01-20
TERMS_VERSION=1.0.0


# ════════════════════════════════════════════════════════════════════════════
#  📞 ATENDIMENTO HUMANO
# ════════════════════════════════════════════════════════════════════════════
SUPPORT_TELEGRAM_USERNAME=@larizinha_suporte
SUPPORT_WHATSAPP_LINK=https://wa.me/5544998312326
SUPPORT_EMAIL=suporte@larizinhastore.com


# ════════════════════════════════════════════════════════════════════════════
#  🐛 DEBUG / DESENVOLVIMENTO
# ════════════════════════════════════════════════════════════════════════════
DEBUG=false
DEBUG_CALLBACK=false
DEBUG_SQL=false
DEBUG_TELEGRAM_PAYLOAD=false
